{
    "compilerOptions": {
        "module": "ES2022",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "downlevelIteration": true,
        "experimentalDecorators": true,
        "jsx": "react-jsx",
        "jsxImportSource": "dom-renderer",
        "target": "ES5",
        "lib": ["ES2023", "DOM"]
    },
    "include": ["source/**/*", "test/**/*"]
}
